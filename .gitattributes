# ---------------------------------------------------------------------------
# Git LFS — binary design sources and production deliverables
# Run `git lfs install` once before cloning or contributing.
# ---------------------------------------------------------------------------

# Vector working files
*.ai        filter=lfs diff=lfs merge=lfs -text
*.eps       filter=lfs diff=lfs merge=lfs -text
*.pdf       filter=lfs diff=lfs merge=lfs -text

# Raster working files
*.psd       filter=lfs diff=lfs merge=lfs -text
*.psb       filter=lfs diff=lfs merge=lfs -text
*.procreate filter=lfs diff=lfs merge=lfs -text

# Production deliverables
*.tif       filter=lfs diff=lfs merge=lfs -text
*.tiff      filter=lfs diff=lfs merge=lfs -text
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.webp      filter=lfs diff=lfs merge=lfs -text

# Colour and font resources
*.ase       filter=lfs diff=lfs merge=lfs -text
*.aco       filter=lfs diff=lfs merge=lfs -text
*.icc       filter=lfs diff=lfs merge=lfs -text
*.woff2     filter=lfs diff=lfs merge=lfs -text

# SVG stays as text so it can be reviewed in a diff
*.svg       text eol=lf

# Normalise line endings for everything textual
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.mjs       text eol=lf

# Keep generated deliverables out of language statistics
dist/**     linguist-generated=true
