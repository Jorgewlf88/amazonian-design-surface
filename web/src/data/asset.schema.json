{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/amazonian-design-surface/web/src/data/asset.schema.json",
  "title": "Surface design asset metadata",
  "description": "Schema for every meta.json inside src/collection/*/<asset-id>/.",
  "type": "object",
  "required": ["id", "title", "tier", "origin", "author", "repeat", "color", "tooling", "license", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^amazonia-(ec|pe|br|co|bo|ve|gy|sr|gf|pan)-(hero|sec|blnd)-[a-z0-9]+(-[a-z0-9]+){0,2}$"
    },
    "title": {
      "type": "object",
      "required": ["en", "es", "pt"],
      "additionalProperties": { "type": "string" }
    },
    "description": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tier": { "enum": ["hero", "secondary", "blender"] },
    "motif_family": {
      "enum": ["flora", "fauna", "geometric", "ritual_geometry", "landscape", "fiber"]
    },
    "origin": {
      "type": "object",
      "required": ["country", "region", "cultural_reference", "custodian_consent", "inspiration_notes"],
      "properties": {
        "country": { "enum": ["ec", "pe", "br", "co", "bo", "ve", "gy", "sr", "gf", "pan"] },
        "region": { "type": "string", "minLength": 3 },
        "cultural_reference": { "type": ["string", "null"] },
        "custodian_consent": { "enum": ["not-applicable", "documented", "pending"] },
        "inspiration_notes": { "type": "string", "minLength": 10 }
      }
    },
    "author": {
      "type": "object",
      "required": ["name", "github"],
      "properties": {
        "name": { "type": "string" },
        "github": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
        "country": { "type": "string" }
      }
    },
    "repeat": {
      "type": "object",
      "required": ["type", "size_cm"],
      "properties": {
        "type": { "enum": ["full-drop", "half-drop", "brick"] },
        "offset_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "size_cm": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "color": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "const": "Coated FOGRA39" },
        "dominant": {
          "type": "array",
          "items": { "enum": ["green", "ochre", "terracotta", "indigo", "black", "natural"] }
        },
        "colorways": { "type": "integer", "minimum": 1 },
        "flat_colors": { "type": "integer", "minimum": 1 }
      }
    },
    "tooling": {
      "type": "array",
      "description": "Every tool used, including disclosed machine assistance on the author's own artwork.",
      "items": { "type": "string" },
      "minItems": 1
    },
    "license": { "const": "CC-BY-SA-4.0" },
    "version": { "type": "string", "pattern": "^v\\d{2}$" }
  }
}
